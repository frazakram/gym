#!/bin/sh
# Pre-commit gate for web-app. Install once with:  cd web-app && npm run hooks:install
# Fast checks only (lint on staged files, typecheck, unit tests); the full
# `npm run verify` (which adds next build) still runs before pushing and in CI.
set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- 'web-app/*' || true)
[ -z "$STAGED" ] && exit 0

cd "$(git rev-parse --show-toplevel)/web-app"

LINTABLE=$(printf '%s\n' "$STAGED" | grep -E '\.(ts|tsx|js|jsx|mjs|mts)$' | sed 's#^web-app/##' || true)
if [ -n "$LINTABLE" ]; then
  echo "pre-commit: eslint (staged files)"
  printf '%s\n' "$LINTABLE" | tr '\n' '\0' | xargs -0 npx --no-install eslint
fi

echo "pre-commit: typecheck"
npm run --silent typecheck

echo "pre-commit: unit tests"
npm run --silent test
