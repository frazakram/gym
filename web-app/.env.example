# ---------------------------------------------------------------------------
# GymBro AI — environment variables.
# Copy to .env.local and fill in. See ENV_SETUP.md for a full walkthrough.
# DO NOT COMMIT real secrets.
# ---------------------------------------------------------------------------

# Local dev in one command:  npm run dev:local
#   (creates .env.local from this file with local Docker Postgres settings,
#    starts Postgres via docker-compose, then runs next dev)

# --- Required ---
JWT_SECRET=                       # random hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_URL=                     # Postgres connection string (or DATABASE_URL / POSTGRES_URL_NON_POOLING / DATABASE_URL_UNPOOLED)

# --- Database driver / TLS ---
DATABASE_DRIVER=                  # unset = Neon serverless (production). "pg" = node-postgres, for local Docker Postgres + tests
DB_SSL_DISABLED=                  # "true" for local Docker Postgres only
DB_SSL_MODE=                      # "require" skips hostname verification (poolers); default verify-full
DB_SSL_REJECT_UNAUTHORIZED=       # "false" disables cert verification (not for production)
CSRF_SECRET=                      # optional; defaults to JWT_SECRET

# --- Auth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOW_MOCK_AUTH=                  # "true" for local dev without a DB. NEVER in production: wrong passwords log in as a demo user

# --- AI providers (optional; users can also enter keys in the UI) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=                  # optional override
OPENAI_MODEL=                     # optional default model override
OPENAI_MODEL_COACH_NOTE=
OPENAI_MODEL_EXERCISE_INFO=
OPENAI_MODEL_NOTES=
OPENAI_RETRY_ATTEMPTS=
YOUTUBE_API_KEY=                  # optional; enables exercise video verification/search
LANGSMITH_API_KEY=                # optional tracing
LANGSMITH_PROJECT=
LANGSMITH_TRACING_V2=

# --- Nutrition tracking ---
# Open Food Facts (food search + barcode) needs NO key. It enforces per-IP rate
# limits (~15 reads/min, ~10 searches/min); the app rate-limits + caches per user.
# OFF only asks for an identifying User-Agent:
OFF_USER_AGENT=GymBroAI/1.0 (you@example.com)
# Photo meal recognition engine priority:
#   1) LogMeal (optional, paid) if LOGMEAL_API_KEY is set
#   2) OpenAI vision (uses OPENAI_API_KEY above) — the default free* engine
#   3) manual search fallback
# So photo logging works as long as OPENAI_API_KEY is set; LogMeal is optional polish.
LOGMEAL_API_KEY=
LOGMEAL_BASE_URL=                 # optional override, default https://api.logmeal.com
OPENAI_VISION_MODEL=              # optional, default gpt-4o (used for photo meal recognition)

# --- Payments (Razorpay, optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID_ANALYTICS_MONTHLY=
RAZORPAY_WEBHOOK_SECRET=

# --- Redis cache + rate limiting (optional) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Admin + misc (optional) ---
ADMIN_USER_IDS=                   # comma-separated user ids (preferred)
ADMIN_USER_ID=                    # legacy single id
ADMIN_USERNAMES=                  # fallback: comma-separated usernames
DEFAULT_COACH_ID=
DEFAULT_COACH_NAME=
DEFAULT_COACH_PHONE=
DEFAULT_COACH_EMAIL=
PREMIUM=                          # "true" grants premium to EVERY user (demo/staging only)
APP_BASE_URL=http://localhost:3000
DB_ENCRYPTION_KEY=                # 64-char hex enables field-level encryption
